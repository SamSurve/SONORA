# ==============================================================================
# Auralis Configuration Environment Variables
# ==============================================================================

# Application Environment (development, production, testing)
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Concurrency & Worker Pool (Default: 4)
MAX_CONCURRENT_WORKERS=4

# Storage & Ephemeral Lifecycle
TEMP_DIR=data/temp
COMPLETED_DIR=data/completed
JOB_TTL_MINUTES=60
DISK_FREE_THRESHOLD_MB=2048
JANITOR_SWEEP_INTERVAL_SECONDS=300
SOCKET_TIMEOUT=20

# Anti-Abuse & Rate Limiting
MAX_PLAYLIST_ITEMS=100
RATE_LIMIT_PER_MINUTE=10

# CORS Configuration (Comma-separated allowed origin domains)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# Database
DB_PATH=data/auralis.db

# FFmpeg Executable Override (Optional: leave blank for auto-discovery)
# FFMPEG_PATH=C:/Program Files/ffmpeg/bin/ffmpeg.exe
